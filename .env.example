# TrueFinds Website Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control

# ==========================================
# Analytics Configuration
# ==========================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# ==========================================
# API Configuration
# ==========================================
# Contact Form API Endpoint
CONTACT_FORM_API_URL=https://api.truefinds.com/contact

# Newsletter API Endpoint
NEWSLETTER_API_URL=https://api.truefinds.com/newsletter

# Analytics API
ANALYTICS_API_URL=https://api.truefinds.com/analytics

# ==========================================
# Third-Party Services
# ==========================================
# Recaptcha Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Public Key (for payments)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Application Settings
# ==========================================
# Environment (development, staging, production)
NODE_ENV=production

# Debug Mode (true/false)
DEBUG=false

# API Version
API_VERSION=v1

# ==========================================
# Social Media Configuration
# ==========================================
# Twitter Username
TWITTER_USERNAME=truefinds

# Facebook Page ID
FACEBOOK_PAGE_ID=123456789

# LinkedIn Company Page
LINKEDIN_COMPANY_ID=truefinds

# ==========================================
# Performance Monitoring
# ==========================================
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o1234.ingest.sentry.io/12345

# Error Tracking Enabled
ERROR_TRACKING_ENABLED=true

# Performance Monitoring Enabled
PERFORMANCE_MONITORING_ENABLED=true

# ==========================================
# Feature Flags
# ==========================================
# Enable new features
FEATURE_NEW_DASHBOARD=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_AI_SUGGESTIONS=true

# Maintenance Mode
MAINTENANCE_MODE=false

# ==========================================
# CDN Configuration
# ==========================================
# CDN Base URL
CDN_BASE_URL=https://cdn.truefinds.com

# Assets URL
ASSETS_URL=https://assets.truefinds.com

# ==========================================
# SEO Configuration
# ==========================================
# Site URL
SITE_URL=https://truefinds.com

# Site Name
SITE_NAME=TrueFinds

# Default SEO Image
DEFAULT_SEO_IMAGE=https://truefinds.com/images/og-image.jpg

# ==========================================
# Rate Limiting
# ==========================================
# Contact Form Rate Limit
CONTACT_FORM_RATE_LIMIT=5

# API Rate Limit
API_RATE_LIMIT=100

# ==========================================
# Security Configuration
# ==========================================
# CORS Origins
CORS_ORIGINS=https://truefinds.com,https://www.truefinds.com

# CSRF Token
CSRF_SECRET_KEY=your-csrf-secret-key-here

# Session Secret
SESSION_SECRET=your-session-secret-here

# ==========================================
# Email Configuration
# ==========================================
# Support Email
SUPPORT_EMAIL=support@truefinds.com

# Sales Email
SALES_EMAIL=sales@truefinds.com

# Email From Address
EMAIL_FROM=noreply@truefinds.com

# ==========================================
# Timezone Configuration
# ==========================================
# Default Timezone
TZ=America/New_York

# ==========================================
# Logging Configuration
# ==========================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Path
LOG_FILE_PATH=./logs/app.log